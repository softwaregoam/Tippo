# Recommended free setup: Docker Desktop + node scripts/local-dev.mjs start
# The setup script writes the local anon key to .env.local without printing it.
TIPPO_APP_ENV=development
TIPPO_DEV_SUPABASE_PROJECT_REF=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_anon_key

# Alternatively use a SEPARATE hosted dev project if a free project slot is available:
# TIPPO_DEV_SUPABASE_PROJECT_REF=your_20_character_ref
# NEXT_PUBLIC_SUPABASE_URL=https://your_20_character_ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_dev_browser_publishable_key

# Payments start disabled. Never use production payment secrets in dev.
NEXT_PUBLIC_DOKU_SANDBOX_ENABLED=false
NEXT_PUBLIC_DOKU_PRODUCTION_TEST_ENABLED=false
NEXT_PUBLIC_DOKU_PRO_ENABLED=false
