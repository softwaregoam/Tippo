# Configure these as private pod environment variables on Helipod.
# For full-VPS Docker Compose, copy this file to .env and chmod 600 .env.
ROUTER_DOMAIN=payments.example.com
ROUTER_DB_PATH=/data/router.sqlite
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
TIPPO_CALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/tippo-payment-events
# Generate once: openssl rand -hex 32. Put the SAME value in Tippo Edge Function Secrets.
TIPPO_ROUTER_EVENT_KEY=
